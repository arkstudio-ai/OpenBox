# ============================================================
# OpenBox Backend - Environment Variables
# Copy this file to .env and modify as needed
# ============================================================

# ── Server ──
HOST=0.0.0.0
PORT=8080
DEBUG=true

# ── Sandbox ──
# Provider: "docker" (local dev) | "kubernetes" (GKE) | "wuying" (cloud desktop)
# SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=openbox-sandbox:latest
# CONTAINER_NAME_PREFIX=openbox-sandbox-

# ── WUYING cloud desktop (only when SANDBOX_PROVIDER=wuying) ──
# Runs the action server as a systemd unit on a pre-provisioned Alibaba Cloud
# desktop. OpenBox never creates or destroys it, and sessions are isolated only
# by working directory (/workspace/sessions/<id>).
# The endpoint is normally a local SSH forward — see scripts/wuying_tunnel.sh.
# WUYING_ENDPOINT=http://127.0.0.1:18000
# WUYING_API_KEY=            # must equal SESSION_API_KEY on the desktop
# WUYING_DESKTOP_ID=ecd-xxxxxxxxxxxxxxxxx
# -- Cloud-desktop view tab (GetConnectionTicket) --
# Region the desktop lives in, and the Wuying end user the web view logs in as
# (see: aliyun ecd describe-desktops). Credentials come from
# ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET or the aliyun CLI profile.
# WUYING_REGION_ID=cn-hangzhou
# WUYING_END_USER_ID=
# -- Per-user desktop provisioning (WUYING_MODE=per_user) --
# OpenBox creates one ECD desktop + one convenience EndUser per user via the
# ECD OpenAPI (ported from bossip wuying-bridge). "shared" keeps the single
# pre-provisioned desktop above.
# WUYING_MODE=shared
# Execution routing is a separate rollback switch. Keep shared for the legacy
# endpoint below; per_desktop requires an independently installed channel on
# every cloud_desktops row.
# WUYING_ROUTING=shared         # shared | per_desktop
# WUYING_CHANNEL=ssh            # direct | ssh
# WUYING_RELAY_HOST=106.15.105.236
# WUYING_RELAY_PORT=2222
# WUYING_RELAY_USER=obxtunnel
# WUYING_RELAY_HOSTKEY=         # complete pinned known_hosts line
# WUYING_TUNNEL_BIND=172.17.0.1
# WUYING_TUNNEL_PORT_RANGE=18100-18999
# WUYING_CHANNEL_KEY=           # exactly 32 bytes, base64 or 64 hex characters
# INTERNAL_API_TOKEN=           # relay AuthorizedKeysCommand callback token
# WUYING_HEALTH_INTERVAL_SEC=30
# WUYING_IMAGE_ID=              # golden image id (m-xxxx); required in per_user mode
# WUYING_OFFICE_SITE_ID=        # e.g. cn-hangzhou+dir-xxxxxxxxxx; required in per_user mode
# WUYING_DESKTOP_TYPE=eds.enterprise_office.6c12g
# WUYING_SYSTEM_DISK_SIZE=50    # must be >= the golden image's size
# Policy group pins the session resolution; "OpenBox Personal 1080p"
# (created 2026-09-01, fixed 1920x1080, high quality) is the deployment-wide
# standard — the desktop canvas and the agent's obx-display both assume it.
# REQUIRED in per_user mode (like WUYING_IMAGE_ID): provisioning refuses to
# create desktops without it, because Alibaba's default policy is
# resolution-adaptive and drifts from what the agent screenshots.
# WUYING_POLICY_GROUP_ID=pg-0bbay5jmvosn8b2hc
# WUYING_CHARGE_TYPE=PostPaid
# WUYING_PERIOD=1               # PrePaid only: Month=1/2/3/6, Year=1/2/3/4/5
# WUYING_PERIOD_UNIT=Month      # Month | Year
# WUYING_AUTO_PAY=true          # required for PrePaid; false creates an unpaid order
# WUYING_AUTO_RENEW=false       # renewal is controlled explicitly by subscription lifecycle
# POOL_ENABLED=false
# POOL_AUTO_PURCHASE=false
# POOL_TARGET_PREWARM=5
# POOL_MAX_UNIT_PRICE_CNY=300
# POOL_MAX_PURCHASES_PER_TICK=1
# POOL_MAX_PURCHASES_PER_DAY=2
# POOL_MIN_ACCOUNT_BALANCE_MULTIPLE=2
# POOL_RENEW_BEFORE_DAYS=3
# POOL_ASSIGN_ON_PROVISION=true
# A2 acceptance desktop plus all twelve explicitly approved bossip desktops.
# The operational first wave is A2 + 013..010; 009 and 008 stay reserve, and
# 001..006 are tagged abandon rather than adopted into prewarm capacity.
# POOL_ADOPT_ALLOWLIST=ecd-0b7gj174mc6f23ctq,ecd-ijea2hjljf9c4wd1b,ecd-5pvbuskezql1d4h5m,ecd-i4c4x8wpqg1lxktmi,ecd-c4qndqrko3db7kjfz,ecd-i4c4x8wpqg1lxktmj,ecd-gj5j513on7j0u97as,ecd-4y9s9igraz7hc58ea,ecd-c51eyfc786uzimn3o,ecd-4y9s9igraz7hc58eb,ecd-ctazuyee5p8enedta,ecd-b9oizzx4rfhbsm1uh,ecd-glxi1nk433hliivri
# FLEET_SNAPSHOT_INTERVAL_SEC=600
# FLEET_CHANNEL_DOWN_ALERT_SEC=600
# WUYING_PASSWORD_SALT=         # per-deployment secret; derives EndUser passwords
# WUYING_ENV_TAG=default        # openbox-env tag: keeps prod/dev desktops apart in one account
# -- OSS asset transfer (browser -> OSS -> cloud desktop; empty = disabled,
#    the frontend then falls back to the legacy chunked sandbox upload) --
# OSS_BUCKET=
# OSS_REGION=cn-hangzhou
# OSS_ENDPOINT=

# ── Kubernetes / GKE (only when SANDBOX_PROVIDER=kubernetes) ──
# K8S_NAMESPACE=openbox-sandbox
# K8S_STORAGE_CLASS=standard-rwo
# K8S_STORAGE_SIZE=10Gi
# K8S_SANDBOX_CPU_REQUEST=250m
# K8S_SANDBOX_CPU_LIMIT=1000m
# K8S_SANDBOX_MEMORY_REQUEST=256Mi
# K8S_SANDBOX_MEMORY_LIMIT=1Gi
# K8S_SANDBOX_SERVICE_ACCOUNT=sandbox-pods
# SANDBOX_IDLE_TIMEOUT=1800
# BLOB_PROVIDER=gcs
# GCS_BUCKET=openbox-backup

# ── AI Agent (LLM) ──
# Model name (LiteLLM format: "provider/model")
# OPENBOX_MODEL=anthropic/claude-sonnet-4-20250514

# API Key (applies to the active model's provider)
# OPENBOX_API_KEY=sk-xxx

# Custom API Base URL (for proxies, self-hosted, or compatible services)
# OPENBOX_BASE_URL=https://your-proxy.example.com/v1

# ── Video generation (BossIP relay / TokenSpace Seedance) ──
# Used by the build agent's video tools; skills provide workflow guidance only.
# Keep the key in .env or your deployment secret store; it is never sent to
# the WUYING sandbox. BossIP uses `/v1/videos` and materializes signed OSS URLs.
# BOSSIP_API_KEY=sk-new-api-token
# BOSSIP_BASE_URL=https://openapi.bossipai.com.cn
#
# Official TokenSpace direct endpoint (if your deployment uses it):
# BOSSIP_API_KEY=sk-tokenspace-token
# BOSSIP_BASE_URL=https://api.tokenspace.net.cn

# Or set provider-specific keys directly (LiteLLM convention)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Web Search (Tavily) ──
# Enables the built-in web_search tool. Keep the real key in .env or your
# deployment secret store; never put it in openbox.json or source control.
# TAVILY_API_KEY=tvly-...

# ── Config file (for advanced settings: MCP, permissions, per-agent overrides) ──
# See openbox.jsonc.example for full template
# OPENBOX_CONFIG=/path/to/openbox.json

# ── XDG directories (usually no need to change) ──
# XDG_CONFIG_HOME=~/.config
# XDG_DATA_HOME=~/.local/share

# ============================================================
# Multi-User Infrastructure (Phase 1+)
# ============================================================

# ── Database (PostgreSQL) ──
# DATABASE_URL=postgresql+asyncpg://openbox:openbox_dev@localhost:5432/openbox

# ── Redis ──
# REDIS_URL=redis://localhost:6379/0

# ── Blob Storage (Azure / local / GCS) ──
# BLOB_PROVIDER=azure
# BLOB_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# BLOB_AZURE_CONTAINER=ads-staging
# BLOB_LOCAL_PATH=/opt/openbox/blobs
# GCS_BUCKET=openbox-backup

# ── Auth (JWT) ──
# JWT_SECRET=  # Required for multi-user. Generate with: openssl rand -hex 32

# ── Logto OIDC (optional — local username/password still works when unset) ──
# The browser is a public PKCE client, so there is no client secret to store.
# The code-for-token exchange happens server-side to sidestep Logto's CORS
# allowlist; only the redirect URI has to be registered in Logto.
# LOGTO_ENDPOINT=https://account.example.com
# LOGTO_APP_ID=
# LOGTO_APP_SECRET=              # only for a "Traditional Web" (confidential) app;
#                                # leave empty for a SPA/Native app (public client).
#                                # Symptom when missing: oidc.invalid_client at the
#                                # token endpoint, even though sign-in itself worked.
# LOGTO_NATIVE_APP_ID=           # the separate Logto "Native" application the
#                                # mobile app signs in with. A phone cannot keep
#                                # a client secret, so it is a public client of
#                                # its own — and its id is a second accepted
#                                # ID-token audience. Register the app's redirect
#                                # (com.bossip.bipmobile://callback) on it. Empty
#                                # means mobile SSO is off and the app keeps its
#                                # account/password form.
# LOGTO_ISSUER=                    # defaults to {endpoint}/oidc
# LOGTO_JWKS_URI=                  # defaults to {endpoint}/oidc/jwks
# LOGTO_REDIRECT_URI=http://localhost:3000/callback
# LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
#
# ── Environments: dev vs prod (Aliyun) ──────────────────────────────────────
# Two SEPARATE Logto servers back this project. Set exactly one group per env.
# App IDs / endpoints / redirect URIs are non-secret (browser-visible); only
# LOGTO_APP_SECRET is a secret and must never be committed.
#
#   dev  (local frontend on :3000)  ->  Logto @ account.rankgale.ai
#     LOGTO_ENDPOINT=https://account.rankgale.ai
#     LOGTO_APP_ID=f8cc4vjoshp0ewkh76uoj            # "Traditional Web" app
#     LOGTO_APP_SECRET=<copy from Logto console>
#     LOGTO_REDIRECT_URI=http://localhost:3000/callback
#     LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
#
#   prod (frontend on https://ai.bossipai.com.cn)  ->  self-hosted Logto on
#     Aliyun (bossip-gw-1), fronted at https://auth.bossipai.com.cn. The app is
#     "bossip-web". The two redirect URIs below are ALREADY registered on it.
#     LOGTO_ENDPOINT=https://auth.bossipai.com.cn
#     LOGTO_APP_ID=m9383f921ea87ocylm40p            # "Traditional Web" app
#     LOGTO_APP_SECRET=<copy from Logto console -> Applications -> bossip-web>
#     LOGTO_NATIVE_APP_ID=h4cxokmv8yy3w5vge24fn  # app "bossip-mobile" (Native/public client);
#                                               # enables mobile SSO. Its redirect is the app's
#                                               # custom scheme com.bossip.bipmobile://callback
#                                               # (must match mobile Env.ssoRedirectUri), already registered.
#     LOGTO_REDIRECT_URI=https://ai.bossipai.com.cn/callback
#     LOGTO_POST_LOGOUT_REDIRECT_URI=https://ai.bossipai.com.cn
#     # LOGTO_ISSUER / LOGTO_JWKS_URI default to {endpoint}/oidc[/jwks] — leave unset.
#
# Full prod deployment checklist: docs/LOGTO_PROD.md
