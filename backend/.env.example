# ============================================================
# OpenBox Backend - Environment Variables
# Copy this file to .env and modify as needed
# ============================================================

# ── Server ──
HOST=0.0.0.0
PORT=8080
DEBUG=true

# ── Sandbox ──
# Provider: "docker" (local dev) | "kubernetes" (GKE) | "wuying" (cloud desktop)
# SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=openbox-sandbox:latest
# CONTAINER_NAME_PREFIX=openbox-sandbox-

# ── WUYING cloud desktop (only when SANDBOX_PROVIDER=wuying) ──
# Runs the action server as a systemd unit on a pre-provisioned Alibaba Cloud
# desktop. OpenBox never creates or destroys it, and sessions are isolated only
# by working directory (/workspace/sessions/<id>).
# The endpoint is normally a local SSH forward — see scripts/wuying_tunnel.sh.
# WUYING_ENDPOINT=http://127.0.0.1:18000
# WUYING_API_KEY=            # must equal SESSION_API_KEY on the desktop
# WUYING_DESKTOP_ID=ecd-xxxxxxxxxxxxxxxxx
# -- Cloud-desktop view tab (GetConnectionTicket) --
# Region the desktop lives in, and the Wuying end user the web view logs in as
# (see: aliyun ecd describe-desktops). Credentials come from
# ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET or the aliyun CLI profile.
# WUYING_REGION_ID=cn-hangzhou
# WUYING_END_USER_ID=
# -- OSS asset transfer (browser -> OSS -> cloud desktop; empty = disabled,
#    the frontend then falls back to the legacy chunked sandbox upload) --
# OSS_BUCKET=
# OSS_REGION=cn-hangzhou
# OSS_ENDPOINT=

# ── Kubernetes / GKE (only when SANDBOX_PROVIDER=kubernetes) ──
# K8S_NAMESPACE=openbox-sandbox
# K8S_STORAGE_CLASS=standard-rwo
# K8S_STORAGE_SIZE=10Gi
# K8S_SANDBOX_CPU_REQUEST=250m
# K8S_SANDBOX_CPU_LIMIT=1000m
# K8S_SANDBOX_MEMORY_REQUEST=256Mi
# K8S_SANDBOX_MEMORY_LIMIT=1Gi
# K8S_SANDBOX_SERVICE_ACCOUNT=sandbox-pods
# SANDBOX_IDLE_TIMEOUT=1800
# BLOB_PROVIDER=gcs
# GCS_BUCKET=openbox-backup

# ── AI Agent (LLM) ──
# Model name (LiteLLM format: "provider/model")
# OPENBOX_MODEL=anthropic/claude-sonnet-4-20250514

# API Key (applies to the active model's provider)
# OPENBOX_API_KEY=sk-xxx

# Custom API Base URL (for proxies, self-hosted, or compatible services)
# OPENBOX_BASE_URL=https://your-proxy.example.com/v1

# ── Video generation (BossIP relay / TokenSpace Seedance) ──
# Used by the build agent's video tools; skills provide workflow guidance only.
# Keep the key in .env or your deployment secret store; it is never sent to
# the WUYING sandbox. BossIP uses `/v1/videos` and materializes signed OSS URLs.
# DOUBAO_API_KEY=sk-new-api-token
# DOUBAO_BASE_URL=https://openapi.bossipai.com.cn
#
# Official TokenSpace direct endpoint (if your deployment uses it):
# DOUBAO_API_KEY=sk-tokenspace-token
# DOUBAO_BASE_URL=https://api.tokenspace.net.cn

# Or set provider-specific keys directly (LiteLLM convention)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Web Search (Tavily) ──
# Enables the built-in web_search tool. Keep the real key in .env or your
# deployment secret store; never put it in openbox.json or source control.
# TAVILY_API_KEY=tvly-...

# ── Config file (for advanced settings: MCP, permissions, per-agent overrides) ──
# See openbox.jsonc.example for full template
# OPENBOX_CONFIG=/path/to/openbox.json

# ── XDG directories (usually no need to change) ──
# XDG_CONFIG_HOME=~/.config
# XDG_DATA_HOME=~/.local/share

# ============================================================
# Multi-User Infrastructure (Phase 1+)
# ============================================================

# ── Database (PostgreSQL) ──
# DATABASE_URL=postgresql+asyncpg://openbox:openbox_dev@localhost:5432/openbox

# ── Redis ──
# REDIS_URL=redis://localhost:6379/0

# ── Blob Storage (Azure / local / GCS) ──
# BLOB_PROVIDER=azure
# BLOB_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# BLOB_AZURE_CONTAINER=ads-staging
# BLOB_LOCAL_PATH=/opt/openbox/blobs
# GCS_BUCKET=openbox-backup

# ── Auth (JWT) ──
# JWT_SECRET=  # Required for multi-user. Generate with: openssl rand -hex 32

# ── Logto OIDC (optional — local username/password still works when unset) ──
# The browser is a public PKCE client, so there is no client secret to store.
# The code-for-token exchange happens server-side to sidestep Logto's CORS
# allowlist; only the redirect URI has to be registered in Logto.
# LOGTO_ENDPOINT=https://account.example.com
# LOGTO_APP_ID=
# LOGTO_APP_SECRET=              # only for a "Traditional Web" (confidential) app;
#                                # leave empty for a SPA/Native app (public client).
#                                # Symptom when missing: oidc.invalid_client at the
#                                # token endpoint, even though sign-in itself worked.
# LOGTO_ISSUER=                    # defaults to {endpoint}/oidc
# LOGTO_JWKS_URI=                  # defaults to {endpoint}/oidc/jwks
# LOGTO_REDIRECT_URI=http://localhost:3000/callback
# LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
