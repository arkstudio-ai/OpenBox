{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenBox spoken video production contract",
  "type": "object",
  "required": [
    "production_id", "status", "segments", "approvals",
    "approval_details", "render_idempotency_key"
  ],
  "properties": {
    "production_id": {"type": "string"},
    "status": {
      "enum": [
        "init", "needs_script_approval", "script_ok",
        "needs_segments_approval", "needs_spend_approval", "spend_ok",
        "generating", "needs_segment_revision", "generated", "needs_quality_approval",
        "needs_render_approval", "ready_to_render", "delivered"
      ]
    },
    "approvals": {
      "type": "object",
      "required": ["script", "segments", "spend", "quality", "render"],
      "additionalProperties": {"type": "boolean"}
    },
    "approval_details": {
      "type": "object",
      "required": ["script", "segments", "spend", "quality", "render"],
      "additionalProperties": {"$ref": "#/$defs/approvalDetail"}
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id", "ordinal", "revision", "script_text", "prompt",
          "content_hash", "status", "generation_job_id", "model",
          "generation_idempotency_key",
          "transcription_idempotency_key"
        ],
        "properties": {
          "generation_job_id": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "stt_verdict": {"enum": ["ok", "suspect", null]},
          "review_status": {
            "enum": ["accepted", "override", "user_approved", "user_rejected", null]
          },
          "review_note": {"type": ["string", "null"]}
        }
      }
    },
    "render_idempotency_key": {"type": "string"},
    "render_asset_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "approvalDetail": {
      "type": "object",
      "required": [
        "current_scope_hash", "approval_scope_hash", "decision",
        "matches_current_hash"
      ],
      "properties": {
        "current_scope_hash": {"type": "string"},
        "approval_scope_hash": {"type": "string"},
        "decision": {
          "enum": ["approved", "override", "rejected", null]
        },
        "matches_current_hash": {"type": "boolean"}
      }
    }
  }
}
