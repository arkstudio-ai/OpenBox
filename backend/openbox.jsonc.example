{
  // OpenBox config example
  // Copy to openbox.json or openbox.jsonc and modify
  // Supports // and /* */ comments in both .json and .jsonc

  // Default LLM model (LiteLLM format: "provider/model")
  "model": "anthropic/claude-sonnet-4-20250514",

  // Lightweight model for MCP tool filtering (uses same provider gateway).
  // A fast/cheap model that picks relevant tools from large MCP tool lists.
  // Leave empty to use the default model.
  "mcp_filter_model": "openai/gpt-5.2",

  // Optional model for next-step suggestions above the composer.
  // Omit or leave empty to follow the user's selected chat model.
  // Uses the same provider/<model> routing and credentials as ordinary chat.
  "suggestion_model": "",

  // Models the frontend offers in its picker. When empty, only "model" above
  // is offered. Ids carry the provider prefix ("openai/") because that is what
  // selects the request format — an OpenAI-compatible gateway serves Claude and
  // DeepSeek too, and they still need the OpenAI wire format.
  // max_tokens caps one response; context_limit is the whole window and drives
  // both the composer's context ring and when compaction fires. Both are
  // optional — omitted, they fall back to a family heuristic keyed off the id,
  // which is deliberately conservative for models it does not recognise.
  // Set "vision": false for a text-only model, so old screenshots in a
  // conversation are replaced with a note instead of failing the whole turn.
  "models": [
    // { "id": "openai/gpt-5.6-luna", "name": "GPT-5.6 Luna", "max_tokens": 128000, "context_limit": 1050000, "vision": true },
    // { "id": "openai/claude-opus-5", "name": "Claude Opus 5", "max_tokens": 64000, "context_limit": 1000000, "vision": true },
    // { "id": "openai/deepseek-v4-flash", "name": "DeepSeek V4 Flash", "max_tokens": 64000, "context_limit": 1000000, "vision": false }
  ],

  // Provider-specific config: api_key, base_url, extra options
  // Key = provider name (matches model prefix before "/")
  "provider": {
    "anthropic": {
      "api_key": "{env:ANTHROPIC_API_KEY}",
      "base_url": null
    },
    "openai": {
      "api_key": "{env:OPENAI_API_KEY}",
      "base_url": null
    },
    "bossip": {
      "api_key": "{env:BOSSIP_API_KEY}",
      "base_url": "{env:BOSSIP_BASE_URL}",
      // The wire format is a property of the gateway, not of its hostname.
      // Our own new-api answers on a public facade (https://openapi.bossipai.com.cn)
      // and on a VPC address (http://10.100.1.76:3000); declare "bossip_videos"
      // so both use the relay's /v1/videos format. Plain http is accepted only
      // for private-network hosts. Omit it and the format is inferred from the
      // hostname (relay host -> bossip_videos, anything else -> tokenspace_contents).
      "options": { "wire_format": "bossip_videos" }
    },
    // Self-hosted new-api media gateway (sd2 + wan3 video channels).
    // AUTH QUIRK: new-api expects the token RAW in the Authorization header
    // ("Authorization: sk-...", NO "Bearer " prefix) — that is what
    // options.auth_scheme = "raw" declares.
    "newapi": {
      "api_key": "{env:NEWAPI_API_KEY}",
      "base_url": "{env:NEWAPI_BASE_URL}",
      "options": { "auth_scheme": "raw" }
    }
    // Custom / self-hosted example:
    // "custom": {
    //   "api_key": "sk-xxx",
    //   "base_url": "https://your-proxy.example.com/v1",
    //   "options": {}
    // }
  },

  // Built-in image generation/editing. Credentials and base_url are read
  // from the provider above; do not duplicate an API key here. Generated
  // images are uploaded to the configured OSS bucket and indexed in the
  // resource centre automatically.
  "image_generation": {
    "provider": "openai",
    "model": "gpt-image-2",
    "default_size": "auto",
    "default_quality": "medium",
    "output_format": "png",
    "timeout_seconds": 600,
    // Reuse identical completed generations (content-addressed, n==1 only).
    "dedupe": true
  },

  // Async video generation. The build agent receives the associated tools
  // from its fixed allowlist; video-production adds workflow guidance only.
  // FFmpeg/HyperFrames run in WUYING;
  // this section controls only provider polling and signed-OSS lifetimes.
  // The BossIP origin selects its `/v1/videos` format automatically; the
  // official TokenSpace origin keeps the native contents/tasks format.
  "video_generation": {
    "provider": "bossip",
    "model": "wan3.0-video",
    "default_resolution": "720p",
    "default_ratio": "9:16",
    "default_duration": -1,
    "default_generate_audio": true,
    "default_watermark": false,
    "submit_timeout_seconds": 180,
    "status_timeout_seconds": 60,
    "poll_interval_seconds": 5,
    "wait_timeout_seconds": 25,
    "provider_input_url_ttl_seconds": 3600,
    "render_url_ttl_seconds": 86400,
    "max_provider_output_bytes": 1073741824,
    // Per-user daily ceiling on paid generation submits (0 = off), and refusal
    // of a second identical request while one is still in flight. Both are
    // back-pressure standing in for the shared credits ledger — they refuse,
    // they never ask a human to approve a charge.
    "daily_job_limit": 50,
    "refuse_duplicate_in_flight": true,
    // Selectable video models. Declaring one binds it to a wire channel and a
    // credential, which is all that adding a model normally needs — the three
    // protocol adapters stay in tool/video_providers.py, because no config can
    // express "poll metadata.url" or "unwrap a {code,message,data} envelope".
    //
    // The capability fields are enforced before submission, and they are the
    // ONLY record of what a model accepts: the relay exposes no model or
    // pricing endpoint, so nothing is discoverable at runtime. Gateways differ
    // in how they fail — the wan3 adapter 400s on an unknown switch, while the
    // sd2 720p tier DROPS video references, substitutes its own default and
    // bills you, surfacing as a "successful" task that ignored your input.
    //
    // Capability fields: resolutions, ratios, duration_range [min,max],
    // supports_smart_duration (duration -1), supports_seed,
    // supports_first_last_frame, supports_reference_audio,
    // supports_reference_image, supports_reference_video.
    // Explicitly declare wire_shape when deploying external registries:
    // MiniMax-H3 over /v1/videos needs "size" (not top-level ratio/resolution).
    // It uses its native resolution tiers 480p/512p/768p/2k; do not label its
    // rounded output as an exact 720p/1080p tier. This adapter currently encodes
    // 9:16 and 16:9 and forwards image references only.
    //
    // `channel` must match the endpoint your gateway actually exposes, not the
    // model's family. A relay that serves /v1/videos but 404s
    // /v1/video/generations runs wan3.0 on "sd2", not "task".
    //
    // Wan 3.0 is the default below. Keep its explicit sd2 binding when using
    // the BossIP-compatible `/v1/videos` relay; name-based inference would
    // otherwise select the unrelated native `task` protocol.
    "models": [
      { "id": "wan3.0-video", "name": "Wan 3.0", "channel": "sd2",
        "provider": "newapi", "tier": "标准", "max_duration_seconds": 30,
        "resolutions": ["480p", "720p", "1080p"],
        // wan3 refuses 21:9 outright rather than substituting a default,
        // so the accepted set is declared per model rather than globally.
        "ratios": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"],
        "duration_range": [2, 30], "supports_smart_duration": true,
        "supports_seed": true, "supports_first_last_frame": true,
        "supports_reference_audio": true }
      // { "id": "video-sd-720p-proⅠ", "channel": "sd2", "resolutions": ["720p"],
      //   "duration_range": [4, 15], "supports_reference_video": false },
      // { "id": "doubao-seedance-2-0-260128", "channel": "ark",
      //   "resolutions": ["720p", "1080p"], "duration_range": [4, 15] },
    ],
    // Which credential entry serves each gateway channel, for models that do
    // not name their own `provider` above. Model names otherwise select the
    // channel in code (tool/video_providers.py):
    //   sd2 channel:  "seedance-2.0-480-fastⅠ", "video-sd-720p-proⅠ",
    //                 "video-sd-1080p-pro"
    //                 (the trailing Ⅰ is ROMAN NUMERAL ONE U+2160; a plain
    //                 I/i spelling is auto-corrected)
    //   task channel: "wan3.0-video", "wan3.0-video-prime"
    //                 (requires the wan3-video-adapter shim deployed with
    //                 new-api; duration 2-30s or -1 smart duration)
    // A missing channel key disables that channel; everything else stays on
    // the default ark provider above.
    "channel_providers": {
      "sd2": "newapi"
      // "task": "newapi"
    },
    // Optional whitelist for per-segment model overrides; empty = any model
    // the routing accepts.
    "allowed_models": [],
    // Cross-user reuse of identical completed segments (prompt-hash cache).
    "dedupe": true
  },

  // Per-agent overrides
  "agent": {
    // "build": { "model": "openai/gpt-4o", "max_steps": 100 },
    // "explore": { "model": "anthropic/claude-haiku-4-20250514" }
  },

  // Permission rules
  "permission": {},

  // MCP server connections
  "mcp": {
    // Local stdio server:
    // "my-server": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@anthropic/mcp-server-xxx"],
    //   "env": {},
    //   "enabled": true,
    //   "timeout": 60
    // },
    // Remote server with custom headers:
    // "tavily": {
    //   "type": "remote",
    //   "url": "https://mcp.tavily.com/mcp",
    //   "headers": { "X-Api-Key": "your-api-key" },
    //   "timeout": 30
    // },
    // Remote server with OAuth (supports auto-discovery + PKCE):
    // "github": {
    //   "type": "remote",
    //   "url": "https://mcp.github.com/sse",
    //   "oauth": {
    //     "client_id": "your-client-id",
    //     "client_secret": "your-secret",
    //     "authorize_url": "https://github.com/login/oauth/authorize",
    //     "token_url": "https://github.com/login/oauth/access_token",
    //     "scope": "read:user repo"
    //   }
    // }
  },

  // Cloud composition of an OpenBox timeline on Aliyun IMS (video_compose tool;
  // docs/VIDEO_RENDER_ENGINE_SELECTION.md). Reads shots from and writes the MP4
  // to the OSS asset bucket — the same OSS_BUCKET / OSS_REGION from the env
  // file — so nothing leaves the account. Credentials are the Alibaba Cloud
  // access key the OSS transfer already uses (ALIBABA_CLOUD_ACCESS_KEY_ID /
  // _SECRET, or the aliyun CLI profile). One-off per account: activate IMS in
  // the console and grant it the OSS service role, otherwise every call is 403.
  "video_compose": {
    "provider": "ims",
    // Empty = the bucket's region. Keep them equal; cross-region reads fail.
    "region": "",
    // Empty = ice.{region}.aliyuncs.com
    "endpoint": "",
    "bitrate_kbps": 2500,
    "poll_interval_seconds": 5,
    // Per-user daily ceiling on composition submits (0 = off). Back-pressure, not approval.
    "daily_job_limit": 100
  },

  // video_analyze: sampled frames (ffmpeg in the sandbox) + transcript → structured
  // analysis by a vision-capable chat model. min_frames is a hard floor: with no
  // frames the model invents the picture.
  "video_analysis": {
    "model": "openai/gemini-3.7-flash",
    "frames": 8,
    "min_frames": 4,
    "frame_width": 720,
    "max_video_seconds": 600,
    "timeout_seconds": 180,
    "transcribe": true
  },

  // hot_trends: hot-list collection via the workspace's cloud desktop.
  // One collection per (source, board, window, category) per day is shared by all customers.
  "hot_trends": {
    "cache_hours": 24,
    "min_interval_seconds": 300,
    "max_fetches_per_day": 48,
    "fetch_size": 50,
    "page_timeout_seconds": 40,
    "media_link_ttl_hours": 6
  },

  // desktop_publish: post to 抖音创作者中心 via the cloud desktop (transitional route).
  // default_mode "auto" = desktop route, "package" = QR package route (the one global switch).
  "desktop_publish": {
    "default_mode": "auto",
    "daily_limit": 3,
    "min_interval_minutes": 90,
    "window_start_hour": 8,
    "window_end_hour": 23,
    "upload_timeout_seconds": 420,
    "max_title_chars": 30
  },

  // Context compaction settings
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Extra instruction file paths or URLs
  "instructions": []
}
