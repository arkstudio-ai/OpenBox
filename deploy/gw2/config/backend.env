# Placeholder so the example compose files in deploy/gw2 validate in a checkout:
#   docker compose -f deploy/gw2/docker-compose.base.example.yml -f deploy/gw2/docker-compose.trajectory.yml config
# The servers use their own /opt/openbox/config/backend.env. This file is excluded from the release
# bundle (deploy/gw2/.gitattributes). Never put real values here.
JWT_SECRET=placeholder
INTERNAL_API_TOKEN=placeholder
OSS_BUCKET=example-bucket
OSS_REGION=cn-shanghai
TRAJECTORY_RECORDING_ENABLED=false
TRAJECTORY_ADMIN_ENABLED=false
