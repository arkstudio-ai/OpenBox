# Example of /opt/openbox/.env with placeholder values.
# OPENBOX_IMAGE_TAG is stale on gw2: docker-compose.override.yml pins every image, and the pins win.
OPENBOX_IMAGE_TAG=20260915-trajectory-example
OPENBOX_DB_PASSWORD=change-me
# Password of the openbox_trace role (scripts/create-trace-db.sh): 16 to 128 letters, digits, ".", "_",
# "~" or "-", because it is also part of TRAJECTORY_DATABASE_URL. Generate it with: openssl rand -hex 32
OPENBOX_TRACE_DB_PASSWORD=change-me-trace-password
# Optional dedicated PostgreSQL instance; unset uses postgres/openbox_trace on the shared instance.
# OPENBOX_TRACE_DATABASE_URL=postgresql+asyncpg://openbox_trace:<password>@<trace-db-host>:5432/openbox_trace
# COMPOSE_FILE makes every plain `docker compose` command in /opt/openbox include the trajectory
# overlay. Keep the order: base, trajectory overlay, override (the override's image pins win).
COMPOSE_FILE=docker-compose.yml:deploy/gw2/docker-compose.trajectory.yml:docker-compose.override.yml
