# Example of /opt/openbox/.env with placeholder values.
# COMPOSE_FILE makes every plain `docker compose` command in /opt/openbox include the trajectory
# overlay. Keep the order: base, trajectory overlay, override (the override's image pins win).
OPENBOX_IMAGE_TAG=20260915-trajectory-example
OPENBOX_DB_PASSWORD=change-me
COMPOSE_FILE=docker-compose.yml:deploy/gw2/docker-compose.trajectory.yml:docker-compose.override.yml
