[Unit]
Description=OpenBox trajectory analytics export of the previous day (Asia/Shanghai)
Documentation=file:/opt/openbox/deploy/gw2/RUNBOOK.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=OPENBOX_DIR=/opt/openbox
ExecStart=/opt/openbox/deploy/gw2/scripts/analytics-export.sh
TimeoutStartSec=2h
Nice=10
